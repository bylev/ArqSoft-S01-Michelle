@model List<Catalogo.Models.Item>

<div class="filter-section">
    <h1>💿 Mi Catálogo</h1>

    <div class="filter-buttons">
        <a asp-action="Index" class="btn-filter">
            Todos
        </a>
        @foreach (var gen in ViewBag.Generos as List<string>)
        {
            <a asp-action="Index" asp-route-genero="@gen" class="btn-filter">
                @gen
            </a>
        }
        <a asp-action="Agregar" class="btn-add">
            <span class="emoji">+</span> Agregar Álbum
        </a>
    </div>
</div>

@if (Model != null && Model.Count > 0)
{
    <div class="album-grid">
        @foreach (var item in Model)
        {
            <div class="album-card">
                <div class="album-header">
                    <h3 class="album-title">
                        💿 @item.Nombre
                    </h3>
                </div>
                <div class="album-body">
                    <div class="album-info">
                        <div class="album-info-item">
                            <span class="emoji"></span>
                            <span><span class="album-label">Artista:</span> @item.Artista</span>
                        </div>
                        <div class="album-info-item">
                            <span class="emoji"></span>
                            <span><span class="album-label">Género:</span> @item.Genero</span>
                        </div>
                        <div class="album-info-item">
                            <span class="emoji"></span>
                            <span><span class="album-label">Año:</span> @item.Ano</span>
                        </div>
                        <div class="album-info-item">
                            <span class="emoji"></span>
                            <span><span class="album-label">Formato:</span> @item.Formato</span>
                        </div>
                    </div>
                    <div class="album-footer">
                        <a asp-action="Detalle" asp-route-id="@item.Id" class="btn-album btn-view">
                            Ver Detalles
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="alert alert-info text-center" role="alert" style="background: linear-gradient(135deg, rgba(168, 213, 186, 0.2) 0%, rgba(255, 229, 180, 0.2) 100%); border: 2px solid #A8D5BA; border-radius: 15px; padding: 2rem;">
        <p style="font-size: 2rem; margin-bottom: 1rem;">📭</p>
        <p class="mb-0">No hay álbumes disponibles. ¡Comienza <a asp-action="Agregar" style="color: #FFB6D9; text-decoration: underline; font-weight: 600;">agregando uno!</a></p>
    </div>
}